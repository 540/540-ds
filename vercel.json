{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build-mcp-metadata -- --strict",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.ts": {
      "includeFiles": "mcp/metadata.json"
    }
  },
  "rewrites": [{ "source": "/mcp", "destination": "/api/mcp" }],
  "redirects": [{ "source": "/", "destination": "https://ds.540deg.com", "permanent": false }]
}
