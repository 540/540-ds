{
  "name": "@540deg/ds",
  "version": "0.1.0",
  "description": "Sistema de diseño de 540: componentes React, tokens y estilos para montar charlas y webs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/540/540-ds.git"
  },
  "homepage": "https://ds.540deg.com",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pieces": "node scripts/build-pieces.mjs",
    "check:pieces": "node scripts/check-pieces.mjs",
    "check:islands": "npm run build:pieces && node scripts/check-islands.mjs",
    "lint": "oxlint",
    "test:ssr": "vitest run --project=ssr",
    "test:islands": "vitest run --project=islands",
    "test:render": "vitest run --project=render",
    "render": "node scripts/render/cli.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:lib": "node scripts/build-lib.mjs",
    "prepack": "npm run build:lib",
    "build-mcp-metadata": "tsx scripts/build-mcp-metadata.ts",
    "test:mcp": "vitest run --project=mcp",
    "mcp:stdio": "tsx mcp/stdio.ts",
    "mcp:inspect": "npx -y @modelcontextprotocol/inspector tsx mcp/stdio.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.61.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "playwright": "latest",
    "preact": "10.29.8",
    "preact-render-to-string": "6.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "latest",
    "zod": "^4.6.7"
  }
}
